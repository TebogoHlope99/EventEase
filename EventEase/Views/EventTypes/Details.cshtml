@model EventEase.Models.EventType

@{
    ViewData["Title"] = "Event Type Details";
}

<div class="container mt-4">
    <h1><i class="bi bi-tag"></i> Event Type Details</h1>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Type Name</dt>
                        <dd class="col-sm-8">
                            <i class="bi @Model.IconClass"></i> @Model.TypeName
                        </dd>
                        <dt class="col-sm-4">Description</dt>
                        <dd class="col-sm-8">@Model.Description</dd>
                        <dt class="col-sm-4">Color</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-@Model.ColorClass">@Model.ColorClass</span>
                        </dd>
                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </dd>
                        <dt class="col-sm-4">Created</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                        <dt class="col-sm-4">Associated Events</dt>
                        <dd class="col-sm-8">@(Model.Events?.Count ?? 0)</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Events != null && Model.Events.Any())
    {
        <div class="mt-4">
            <h4>Events with this type</h4>
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr><th>Event Name</th><th>Date</th><th>Venue</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in Model.Events)
                        {
                            <tr>
                                <td>@ev.EventName</td>
                                <td>@ev.EventDate.ToString("yyyy-MM-dd")</td>
                                <td>@ev.Venue?.VenueName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.EventTypeId" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>