@model EventEase.Models.Venue

@{
    ViewData["Title"] = "Venue Details";
}

<h1>Venue Details</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5>@Model.VenueName</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Venue Name</dt>
                    <dd class="col-sm-9">@Model.VenueName</dd>
                    <dt class="col-sm-3">Location</dt>
                    <dd class="col-sm-9">@Model.Location</dd>
                    <dt class="col-sm-3">Capacity</dt>
                    <dd class="col-sm-9"><span class="badge bg-info">@Model.Capacity people</span></dd>
                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">@(Model.IsAvailable ? "Available" : "Not Available")</dd>
                    <dt class="col-sm-3">Created</dt>
                    <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5>Image</h5>
            </div>
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.VenueName" class="img-fluid rounded" style="max-height: 200px;" />
                }
                else
                {
                    <div class="text-muted"><i class="bi bi-image" style="font-size: 50px;"></i><p>No image available</p></div>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.VenueId" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>