@model EventEase.Models.Venue

@{
    ViewData["Title"] = "Delete Venue";
}

<h1>Delete Venue</h1>

<div class="alert alert-danger">
    <h4>Are you sure you want to delete this venue?</h4>
    <p class="mb-0">This action cannot be undone.</p>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5>Venue Details</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.VenueName)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.VenueName)
                    </dd>

                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.Location)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.Location)
                    </dd>

                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.Capacity)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.Capacity)
                    </dd>

                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.CreatedAt)
                    </dt>
                    <dd class="col-sm-9">
                        @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5>Image</h5>
            </div>
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.VenueName" class="img-fluid rounded" style="max-height: 200px;" />
                }
                else
                {
                    <img src="https://placehold.co/600x400/3b82f6/white?text=No+Image" alt="No Image" class="img-fluid rounded" style="max-height: 200px;" />
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    @if (ViewBag.HasBookings != null && ViewBag.HasBookings)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i>
            This venue has associated bookings and cannot be deleted. Please delete all bookings first.
        </div>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    }
    else
    {
        <form asp-action="Delete">
            <input type="hidden" asp-for="VenueId" />
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    }
</div>