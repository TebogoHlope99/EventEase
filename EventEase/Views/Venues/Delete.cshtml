@model EventEase.Models.Venue

@{
    ViewData["Title"] = "Delete Venue";
}

<h1>Delete Venue</h1>

<div class="alert alert-danger">
    <h4>Are you sure you want to delete this venue?</h4>
    <p class="mb-0">This action cannot be undone.</p>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header"><h5>Venue Details</h5></div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Venue Name</dt>
                    <dd class="col-sm-9">@Model.VenueName</dd>
                    <dt class="col-sm-3">Location</dt>
                    <dd class="col-sm-9">@Model.Location</dd>
                    <dt class="col-sm-3">Capacity</dt>
                    <dd class="col-sm-9">@Model.Capacity</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header"><h5>Image</h5></div>
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.VenueName" style="max-height: 150px;" />
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    @if (ViewBag.HasBookings == true)
    {
        <div class="alert alert-warning">This venue has associated bookings and cannot be deleted.</div>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    }
    else
    {
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="VenueId" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    }
</div>