@model EventEase.Models.Event

@{
    ViewData["Title"] = "Edit Event";
}

<h1>Edit Event</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" enctype="multipart/form-data" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="EventId" />
            <input type="hidden" asp-for="CreatedAt" />

            <div class="form-group mb-3">
                <label asp-for="EventName" class="control-label"></label>
                <input asp-for="EventName" class="form-control" />
                <span asp-validation-for="EventName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EventDate" class="control-label"></label>
                <input asp-for="EventDate" class="form-control" type="datetime-local" />
                <span asp-validation-for="EventDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <!-- Event Type Dropdown - ADD THIS -->
            <div class="form-group mb-3">
                <label asp-for="EventTypeId" class="control-label">Event Type</label>
                <select asp-for="EventTypeId" class="form-control" asp-items="ViewBag.EventTypes">
                    <option value="">-- Select Event Type --</option>
                </select>
                <span asp-validation-for="EventTypeId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="VenueId" class="control-label">Venue</label>
                <select asp-for="VenueId" class="form-control" asp-items="ViewBag.Venues">
                    <option value="">-- Select Venue --</option>
                </select>
                <span asp-validation-for="VenueId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Change Image</label>
                <input type="file" name="imageFile" class="form-control" accept="image/jpeg,image/png,image/gif" />
                <small class="form-text text-muted">Leave empty to keep current image</small>
            </div>

            <div class="form-group mb-3">
                <div class="form-check">
                    <input type="checkbox" name="deleteImage" class="form-check-input" id="deleteImage" value="true" />
                    <label class="form-check-label text-danger" for="deleteImage">
                        <i class="bi bi-trash"></i> Delete current image
                    </label>
                </div>
            </div>

            <div class="form-group mb-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Save
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>
        </form>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Current Image</h5>
            </div>
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.EventName" class="img-fluid rounded" style="max-height: 200px;" />
                }
                else
                {
                    <div class="text-muted">
                        <i class="bi bi-image" style="font-size: 50px;"></i>
                        <p>No image available</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}