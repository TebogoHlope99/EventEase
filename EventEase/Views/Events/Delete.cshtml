@model EventEase.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<h1>Delete Event</h1>

<div class="alert alert-danger">
    <h4>Are you sure you want to delete this event?</h4>
    <p class="mb-0">This action cannot be undone.</p>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5>Event Details</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.EventName)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.EventName)
                    </dd>

                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.EventDate)
                    </dt>
                    <dd class="col-sm-9">
                        @Model.EventDate.ToString("yyyy-MM-dd HH:mm")
                    </dd>

                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.Description)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.Description)
                    </dd>

                    <dt class="col-sm-3">
                        Venue
                    </dt>
                    <dd class="col-sm-9">
                        @(Model.Venue?.VenueName ?? "No Venue Assigned")
                    </dd>

                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.CreatedAt)
                    </dt>
                    <dd class="col-sm-9">
                        @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5>Image</h5>
            </div>
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.EventName" class="img-fluid rounded" style="max-height: 200px;" />
                }
                else
                {
                    <img src="https://placehold.co/600x400/8b5cf6/white?text=No+Image" alt="No Image" class="img-fluid rounded" style="max-height: 200px;" />
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    @if (ViewBag.HasBookings != null && ViewBag.HasBookings)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i>
            This event has associated bookings and cannot be deleted. Please delete all bookings first.
        </div>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    }
    else
    {
        <form asp-action="Delete">
            <input type="hidden" asp-for="EventId" />
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    }
</div>