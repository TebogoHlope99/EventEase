@model EventEase.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<h1>Event Details</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5>@Model.EventName</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Event Name</dt>
                    <dd class="col-sm-9">@Model.EventName</dd>

                    <dt class="col-sm-3">Event Date</dt>
                    <dd class="col-sm-9">@Model.EventDate.ToString("yyyy-MM-dd HH:mm")</dd>

                    <dt class="col-sm-3">Event Type</dt>
                    <dd class="col-sm-9">
                        @if (Model.EventType != null)
                        {
                            <span class="badge bg-@(Model.EventType.ColorClass)">
                                <i class="@Model.EventType.IconClass"></i> @Model.EventType.TypeName
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Uncategorized</span>
                        }
                    </dd>

                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">@Model.Description</dd>

                    <dt class="col-sm-3">Venue</dt>
                    <dd class="col-sm-9">
                        @if (Model.Venue != null)
                        {
                            <a asp-controller="Venues" asp-action="Details" asp-route-id="@Model.VenueId">
                                @Model.Venue.VenueName
                            </a>
                            <br />
                            <small class="text-muted">@Model.Venue.Location (Capacity: @Model.Venue.Capacity)</small>
                        }
                        else
                        {
                            <span class="text-muted">No venue assigned</span>
                        }
                    </dd>

                    <dt class="col-sm-3">Created</dt>
                    <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5>Image</h5>
            </div>
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.EventName" class="img-fluid rounded" style="max-height: 200px;" />
                }
                else
                {
                    <div class="text-muted">
                        <i class="bi bi-image" style="font-size: 50px;"></i>
                        <p>No image available</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.EventId" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>