@model EventEase.Models.Booking

@{
    ViewData["Title"] = "Booking Details";
}

<h1>Booking Details</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5>Booking #@Model.BookingId</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.BookingId)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.BookingId)
                    </dd>

                    <dt class="col-sm-3">
                        Event
                    </dt>
                    <dd class="col-sm-9">
                        <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId">
                            @Model.Event?.EventName
                        </a>
                    </dd>

                    <dt class="col-sm-3">
                        Venue
                    </dt>
                    <dd class="col-sm-9">
                        <a asp-controller="Venues" asp-action="Details" asp-route-id="@Model.VenueId">
                            @Model.Venue?.VenueName
                        </a>
                        <br />
                        <small class="text-muted">@Model.Venue?.Location (Capacity: @Model.Venue?.Capacity)</small>
                    </dd>

                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.BookingDate)
                    </dt>
                    <dd class="col-sm-9">
                        @Model.BookingDate.ToString("yyyy-MM-dd")
                    </dd>

                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.CreatedAt)
                    </dt>
                    <dd class="col-sm-9">
                        @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                    </dd>
                </dl>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h5>Event Details</h5>
            </div>
            <div class="card-body">
                @if (Model.Event != null)
                {
                    <p><strong>Event Name:</strong> @Model.Event.EventName</p>
                    <p><strong>Event Date:</strong> @Model.Event.EventDate.ToString("yyyy-MM-dd HH:mm")</p>
                    <p><strong>Description:</strong> @Model.Event.Description</p>
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h5>Venue Details</h5>
            </div>
            <div class="card-body">
                @if (Model.Venue != null)
                {
                    <p><strong>Venue Name:</strong> @Model.Venue.VenueName</p>
                    <p><strong>Location:</strong> @Model.Venue.Location</p>
                    <p><strong>Capacity:</strong> @Model.Venue.Capacity</p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5>Images</h5>
            </div>
            <div class="card-body">
                @if (Model.Event != null && !string.IsNullOrEmpty(Model.Event.ImageUrl))
                {
                    <h6>Event Image</h6>
                    <img src="@Model.Event.ImageUrl" alt="@Model.Event.EventName" class="img-fluid rounded mb-3" style="max-height: 150px;" />
                }

                @if (Model.Venue != null && !string.IsNullOrEmpty(Model.Venue.ImageUrl))
                {
                    <h6>Venue Image</h6>
                    <img src="@Model.Venue.ImageUrl" alt="@Model.Venue.VenueName" class="img-fluid rounded" style="max-height: 150px;" />
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.BookingId" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>