@model EventEase.Models.Booking

@{
    ViewData["Title"] = "Delete Booking";
}

<h1>Delete Booking</h1>

<div class="alert alert-danger">
    <h4>Are you sure you want to delete this booking?</h4>
    <p class="mb-0">This action cannot be undone.</p>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5>Booking Details</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.BookingId)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.BookingId)
                    </dd>

                    <dt class="col-sm-3">
                        Event
                    </dt>
                    <dd class="col-sm-9">
                        @Model.Event?.EventName
                    </dd>

                    <dt class="col-sm-3">
                        Venue
                    </dt>
                    <dd class="col-sm-9">
                        @Model.Venue?.VenueName
                    </dd>

                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.BookingDate)
                    </dt>
                    <dd class="col-sm-9">
                        @Model.BookingDate.ToString("yyyy-MM-dd")
                    </dd>

                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.CreatedAt)
                    </dt>
                    <dd class="col-sm-9">
                        @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5>Event & Venue Info</h5>
            </div>
            <div class="card-body">
                @if (Model.Event != null && !string.IsNullOrEmpty(Model.Event.ImageUrl))
                {
                    <img src="@Model.Event.ImageUrl" alt="@Model.Event.EventName" class="img-fluid rounded mb-2" style="max-height: 100px;" />
                    <p><strong>Event:</strong> @Model.Event.EventName</p>
                }

                @if (Model.Venue != null && !string.IsNullOrEmpty(Model.Venue.ImageUrl))
                {
                    <img src="@Model.Venue.ImageUrl" alt="@Model.Venue.VenueName" class="img-fluid rounded mb-2" style="max-height: 100px;" />
                    <p><strong>Venue:</strong> @Model.Venue.VenueName</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <form asp-action="Delete">
        <input type="hidden" asp-for="BookingId" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>