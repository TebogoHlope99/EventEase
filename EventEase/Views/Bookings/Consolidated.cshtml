@model IEnumerable<EventEase.Models.BookingViewModel>

@{
    ViewData["Title"] = "Booking Dashboard";
}

<div class="container-fluid mt-4">
    <h1 class="mb-4"><i class="bi bi-grid-3x3-gap-fill"></i> Booking Dashboard</h1>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm @(item.IsUpcoming ? "border-success" : "border-secondary")">
                    <div class="card-header bg-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge @(item.IsUpcoming ? "bg-success" : "bg-secondary")">
                                @item.Status
                            </span>
                            <small class="text-muted">Booking #@item.BookingId</small>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-6">
                                @if (!string.IsNullOrEmpty(item.EventImageUrl))
                                {
                                    <img src="@item.EventImageUrl" alt="@item.EventName" class="img-fluid rounded" style="height: 120px; width: 100%; object-fit: cover;" />
                                }
                                <p class="mt-2 text-center"><strong>Event</strong></p>
                            </div>
                            <div class="col-6">
                                @if (!string.IsNullOrEmpty(item.VenueImageUrl))
                                {
                                    <img src="@item.VenueImageUrl" alt="@item.VenueName" class="img-fluid rounded" style="height: 120px; width: 100%; object-fit: cover;" />
                                }
                                <p class="mt-2 text-center"><strong>Venue</strong></p>
                            </div>
                        </div>

                        <h5 class="mt-3">@item.EventName</h5>
                        <p class="text-muted small">@item.EventDescription</p>

                        <hr />

                        <div class="row small">
                            <div class="col-6">
                                <i class="bi bi-building"></i> @item.VenueName
                            </div>
                            <div class="col-6">
                                <i class="bi bi-geo-alt"></i> @item.Location
                            </div>
                            <div class="col-6 mt-2">
                                <i class="bi bi-people"></i> Capacity: @item.Capacity
                            </div>
                            <div class="col-6 mt-2">
                                <i class="bi bi-calendar"></i> @item.BookingDate.ToString("MMM dd, yyyy")
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-white">
                        <div class="d-flex justify-content-between">
                            <a asp-controller="Events" asp-action="Details" asp-route-id="@item.BookingId" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-info-circle"></i> Event Details
                            </a>
                            <a asp-controller="Venues" asp-action="Details" asp-route-id="@item.BookingId" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-building"></i> Venue Details
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>